<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.lordbao.bigevent.mapper.UserMapper">
    <insert id="add">
        INSERT INTO user(username, password, create_time, update_time) VALUES (#{username},#{password},now(),now())
    </insert>
    <select id="findByUsername" resultType="com.lordbao.bigevent.pojo.User">
        SELECT  * FROM  user
        WHERE  username = #{username}
    </select>

    <select id="findByUsernameAndPassword" resultType="com.lordbao.bigevent.pojo.User">
        SELECT * FROM user
        WHERE username=#{username} AND password =#{password}
    </select>
</mapper>